# Environment variables template for CivicPulse
# Copy this file to .env and fill in your values
# DO NOT COMMIT .env TO GIT REPOSITORY

# Database Configuration
POSTGRES_USER=civicpulse_user
POSTGRES_PASSWORD=civicpulse_password
POSTGRES_DB=civicpulse_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://civicpulse_user:civicpulse_password@postgres:5432/civicpulse_db

# Redis Cache Configuration
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# Backend Application Configuration
APP_ENV=development
PORT=8000
SECRET_KEY=change_this_to_a_secure_random_string_in_production
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173

# AI Triage Provider Configuration
# Options: 'groq', 'ollama', 'rules', 'simulated'
TRIAGE_PROVIDER=simulated

# LLM API Keys (Required if TRIAGE_PROVIDER=groq or TRIAGE_PROVIDER=openai)
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# Ollama Configuration (Required if TRIAGE_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
